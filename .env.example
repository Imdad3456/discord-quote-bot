DISCORD_TOKEN=your-bot-token-here
QUOTES_CHANNEL_ID=123456789012345678
QUOTES_FILE=quotes.json
NAMES_FILE=names.json
NICKNAMES_FILE=nicknames.json
# Encrypts saved quotes, names and attachments. Make one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep a copy somewhere safe: without it, the quotes and their backups can't be opened.
QUOTES_KEY=
# The owner: the only person who can get the quote book, and who is DMed when a
# quote's attribution can't be resolved. If unset, nobody can get the book.
MOD_USER_ID=
# Optional: UTC hour (0-23) to post the daily "Quote of the Day". Defaults to 13 (1pm UTC).
QUOTE_OF_DAY_HOUR_UTC=13
# Optional: channel ID for the daily "Quote of the Day" post. Defaults to QUOTES_CHANNEL_ID if unset.
ANNOUNCEMENTS_CHANNEL_ID=
# Optional: delete formatted quotes from Discord once they are saved. Defaults to true.
DELETE_RECORDED_QUOTES=true
# Optional: hide quotes from everyone until the year-end book. Defaults to true.
QUOTES_SEALED=true
# Optional: month-day the current year's book opens for the owner. Defaults to 12-31.
QUOTE_BOOK_OPENS=12-31
# Optional: timezone that decides a quote's date and year. Defaults to America/New_York.
QUOTES_TIMEZONE=America/New_York

# Private web music dashboard. Railway supplies RAILWAY_PUBLIC_DOMAIN automatically.
DASHBOARD_TOKEN=
# Optional outside Railway, for example https://music.example.com
DASHBOARD_PUBLIC_URL=

# Optional music server. Leave URI blank to keep running quotes only.
LAVALINK_URI=
LAVALINK_PASSWORD=
# These are used by the Lavalink service, not the Python bot.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional authenticated YouTube playback, configured on Lavalink only.
YOUTUBE_OAUTH_ENABLED=false
YOUTUBE_REFRESH_TOKEN=
